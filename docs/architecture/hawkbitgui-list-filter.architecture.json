  "cards": [
    {
      "dot": "cyan",
      "title": "Server-side filters",
      "items": [
        "Distribution sets, Distributions, Targets and Software modules build an RSQL q= filter",
        "The date range is widened to the start and end of the chosen days"
      ]
    },
    {
      "dot": "emerald",
      "title": "Client-side filters",
      "items": [
        "Deployment action history filters already-loaded rows in memory",
        "Action history offers both action: and ds: type options"
      ]
    },
    {
      "dot": "cyan",
      "title": "Inline artifact downloads",
      "items": [
        "Expanding a software module row lists its artifacts with sizes, hashes and a download link",
        "The Next.js route reuses the server-side session credential and streams the bytes without buffering"
      ]
    },
    {
      "dot": "violet",
      "title": "Distribution set type fix",
      "items": [
        "Action history queries the global /actions feed filtered by target.controllerId",
        "The distribution set id is parsed from _links.distributionset.href and its type resolved from a cached list"
      ]
    },
    {
      "dot": "amber",
      "title": "Transport",
      "items": [
        "The browser calls /api/hawkbit for management and /api/softwaremodules/…/download for artifact bytes",
        "Both proxies reach the hawkBit Management API over plain LAN HTTP; no TLS is configured"
      ]
    }
  ]
